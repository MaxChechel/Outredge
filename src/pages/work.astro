---
import BaseLayout from '../components/shells/BaseLayout.astro';
import Section from '../components/Section.astro';
import WorkCard from '../components/blocks/WorkCard.astro';
import CtaBanner from '../components/blocks/CtaBanner.astro';
import { getWork } from '../lib/work';

const work = await getWork();
---

<BaseLayout
  title="Work | Outredge"
  description="Senior Webflow design and development for B2B tech startups. Principal-led, performance-built, no handoffs. Trusted by Replit, Lindy, Sphere."
>
  <Section spaceTop="top" spaceBottom="lg" border>
    <div class="flex flex-col gap-2xl p-md">
      <div class="flex flex-col gap-md">
        <h1 class="text-h1 text-trim" data-reveal>Selected work.</h1>
        <p class="text-body-lg text-text-muted max-w-measure" data-reveal>
          Marketing sites engineered to match the product. Webflow design and development for
          B2B tech startups across AI, dev tools, and fintech.
        </p>
      </div>

      <ul class="list-bare grid gap-2xl sm:grid-cols-2">
        {work.map((item, i) => <WorkCard item={item} priority={i < 2} level={2} />)}
      </ul>
    </div>
  </Section>

  <CtaBanner />
</BaseLayout>
