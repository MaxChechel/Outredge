---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  name: string;
  kind: string;
  body: string;
  details: readonly string[];
  price: string;
  href: string;
}

const { icon, name, kind, body, details, price, href } = Astro.props as Props;
---

<div class="flex flex-col items-start gap-md px-sm py-lg">
  <div class="flex items-start gap-2xs">
    <Icon name={icon} class="mt-3xs" />
    <div class="flex flex-col gap-3xs">
      <h3 class="text-h5 text-trim">{name}</h3>
      <p class="text-body-sm text-text-muted">{kind}</p>
    </div>
  </div>

  <p class="text-body-sm">{body}</p>

  <div class="flex flex-col gap-2xs">
    {details.map((detail) => <p class="text-body-sm text-text-muted">{detail}</p>)}
  </div>

  <div class="mt-auto flex flex-col gap-2xs pt-xs">
    <p class="text-body">{price}</p>
    <a
      href={href}
      rel="noopener noreferrer"
      target="_blank"
      class="text-body underline underline-offset-4 decoration-border transition-colors duration-base ease-out hover:decoration-current"
    >
      Book a call<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</div>
