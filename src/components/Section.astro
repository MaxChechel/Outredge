---
/**
 * Section — the page grammar (§4.4).
 *
 * The only thing pages compose. Section owns all vertical rhythm, the container
 * width and the theme; pages make no spacing decisions and there are no spacer
 * divs anywhere. The Webflow export built rhythm out of empty
 * `<div class="u-section-spacer">` elements — 14 on the homepage alone.
 */
export type SectionSpace = 'none' | 'sm' | 'md' | 'lg';
/** Widen as themes are added to global.css. */
export type SectionTheme = 'light';

interface Props {
  /** Element to render. Use `header`/`footer` for landmarks. */
  as?: 'section' | 'div' | 'header' | 'footer' | 'article' | 'aside';
  /** Remaps the semantic colour tokens for this section and its descendants. */
  theme?: SectionTheme;
  /** Symmetric vertical padding. */
  space?: SectionSpace;
  /**
   * Asymmetric overrides. These compose with `space`: `space="md" spaceTop="lg"`
   * gives lg top and md bottom. `nav` is the page-top step, used by first-in-page
   * sections to clear the fixed nav.
   */
  spaceTop?: SectionSpace | 'nav';
  spaceBottom?: SectionSpace;
  /** Inner max-width. `full` keeps the wrapper and skips the max-width only. */
  width?: 'main' | 'narrow' | 'full';
  id?: string;
  class?: string;
  /** Applied to the inner container, for grid/flex composition by the caller. */
  innerClass?: string;
  /** Any other attribute is forwarded to the rendered element. */
  [key: string]: unknown;
}

const {
  as: Tag = 'section',
  theme,
  space = 'md',
  spaceTop,
  spaceBottom,
  width = 'main',
  id,
  class: className,
  innerClass,
  ...rest
} = Astro.props as Props;

const PAD_TOP = {
  none: 'pt-section-none',
  sm: 'pt-section-sm',
  md: 'pt-section-md',
  lg: 'pt-section-lg',
  nav: 'pt-section-nav',
} as const;

const PAD_BOTTOM = {
  none: 'pb-section-none',
  sm: 'pb-section-sm',
  md: 'pb-section-md',
  lg: 'pb-section-lg',
} as const;

/**
 * `full` maps to no max-width rather than to no wrapper: full-bleed is a
 * container variant, not a different component, so theme and spacing behave
 * identically either way.
 */
const WIDTH = {
  main: 'max-w-main',
  narrow: 'max-w-narrow',
  full: '',
} as const;

const paddingTop = PAD_TOP[spaceTop ?? space];
const paddingBottom = PAD_BOTTOM[spaceBottom ?? space];
const isFullBleed = width === 'full';
---

<Tag
  id={id}
  data-theme={theme}
  class:list={['relative', paddingTop, paddingBottom, className]}
  {...rest}
>
  <div
    class:list={[
      'relative',
      isFullBleed ? 'w-full' : 'container-gutter',
      WIDTH[width],
      innerClass,
    ]}
  >
    <slot />
  </div>
</Tag>
