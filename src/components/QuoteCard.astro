---
import ClientLogo from './ClientLogo.astro';
import type { Testimonial } from '../data/testimonials';

/**
 * A client quote. `featured` is the centred lead treatment on the subtle
 * background; the default is a grid cell whose rules come from the parent.
 */
interface Props {
  testimonial: Testimonial;
  featured?: boolean;
}

const { testimonial: t, featured = false } = Astro.props as Props;
---

{
  featured ? (
    <figure class="flex flex-col items-center gap-sm border-b border-border bg-bg-subtle px-gutter py-section-md text-center">
      <ClientLogo slug={t.logoSlug} title={`${t.company} logo`} class="text-text-muted" />
      <blockquote class="text-h4 text-trim max-w-measure">
        &ldquo;{t.quote}&rdquo;
      </blockquote>
      <figcaption class="text-body-sm text-text-muted">
        {t.author}, {t.company}
      </figcaption>
    </figure>
  ) : (
    <figure class="flex h-full flex-col items-start gap-md px-sm py-lg">
      <ClientLogo slug={t.logoSlug} title={`${t.company} logo`} class="text-text-muted" />
      <blockquote class="text-body-sm text-trim">&ldquo;{t.quote}&rdquo;</blockquote>
      <figcaption class="text-body-sm text-text-muted mt-auto">
        {t.author}, {t.company}
      </figcaption>
    </figure>
  )
}
