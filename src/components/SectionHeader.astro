---
/**
 * Section header: eyebrow + heading on the left, supporting copy bottom-right.
 *
 * A two-column grid framed by a rule top and bottom, with asymmetric vertical
 * padding — more above than below — exactly as the export lays it out. It is
 * full-bleed inside the container, so it sits flush to the container hairlines.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  /** Heading level. Visual size is identical; only the semantics change. */
  as?: 'h2' | 'h3';
  support?: string;
  /** Top-align the two columns instead of baseline-ing them at the bottom. */
  alignTop?: boolean;
  /** Cap the support copy at 50ch. Uncapped by default — the export only
      constrains it on the pricing header. */
  narrowSupport?: boolean;
  id?: string;
  class?: string;
}

const { eyebrow, heading, as = 'h2', support, alignTop = false, narrowSupport = false, id, class: className } =
  Astro.props as Props;

// Support copy arrives either as a plain string or, when it needs a line break,
// as a named slot. Either one should render the column.
const hasSupport = Boolean(support) || Astro.slots.has('support');

const headingClass = 'text-h2 text-trim';
---

<div
  id={id}
  class:list={[
    'grid gap-md border-y border-border px-gutter pt-section-md pb-section-sm',
    'md:grid-cols-2',
    alignTop ? 'items-start' : 'items-end',
    className,
  ]}
>
  <div class="flex flex-col gap-xs">
    {eyebrow && <p class="text-eyebrow">{eyebrow}</p>}
    {as === 'h3' ? <h3 class={headingClass}>{heading}</h3> : <h2 class={headingClass}>{heading}</h2>}
  </div>
  {
    hasSupport && (
      <div class="flex md:justify-end">
        <p class:list={["text-body-sm text-text-muted md:text-right", narrowSupport && "max-w-support"]}>
          <slot name="support">{support}</slot>
        </p>
      </div>
    )
  }
</div>
