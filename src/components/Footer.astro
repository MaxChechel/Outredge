---
import Logo from './Logo.astro';
import RingMark from './RingMark.astro';
import Section from './Section.astro';
import { footerLinks } from '../data/site';
---

<Section as="footer" space="none" border>
  <!-- Prefooter: the ring mark, large and centred. -->
  <div class="flex items-center justify-center border-t border-border py-section-md">
    <RingMark class="h-prefooter text-text" title="Outredge" />
  </div>

  <div
    class="flex flex-col items-center gap-md border-t border-border px-gutter py-sm md:flex-row md:justify-between"
  >
    <a href="/" class="inline-flex rounded-sm" aria-label="Outredge — home">
      <Logo />
    </a>

    <nav aria-label="Footer">
      <ul class="list-bare flex flex-wrap items-center justify-center gap-md">
        {
          footerLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-body-sm text-text-muted transition-colors duration-base ease-out hover:text-text"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="text-body-sm text-text-muted">&copy; {new Date().getFullYear()} Outredge</p>
  </div>
</Section>
