---
import RingMark from './RingMark.astro';
import Section from './Section.astro';
import { navLinks, site } from '../data/site';
---

<Section as="footer" space="none" border>
  <!-- Prefooter: the ring mark, sized as a share of the container like the export. -->
  <div class="flex items-center justify-center border-t border-border pt-section-md pb-section-lg">
    <RingMark class="w-prefooter text-text" title={site.name} />
  </div>

  <div
    class="flex flex-col items-center gap-md border-t border-border px-gutter pt-md pb-2xl md:flex-row md:justify-between"
  >
    <p class="text-body-sm">{site.name}</p>

    <nav aria-label="Footer">
      <ul class="list-bare flex flex-wrap items-center justify-center gap-sm">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-body-sm text-text-muted transition-colors duration-base ease-out hover:text-text"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/contact"
      class="text-body-sm text-text-muted transition-colors duration-base ease-out hover:text-text"
    >
      Contact
    </a>
  </div>
</Section>
