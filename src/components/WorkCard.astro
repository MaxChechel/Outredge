---
import type { WorkItem } from '../data/work';

/**
 * Work card — thumbnail, title, services.
 *
 * The whole card is one link. The export used an absolutely-positioned overlay
 * anchor that duplicated the label two or three times in the DOM, which is how
 * every card ended up announcing itself as "Website name goes here".
 *
 * Phase 3 layers a poster video over the still for featured items.
 */
interface Props {
  item: WorkItem;
  /** First row on a page gets eager loading; everything below the fold is lazy. */
  priority?: boolean;
  /**
   * Heading level for the card title, so the document outline stays contiguous.
   * On /work the cards sit directly under the h1 and are level 2; in the
   * homepage reel they sit under a section heading and are level 3.
   * Branched rather than rendered via a dynamic tag — see SectionHeader.
   */
  level?: 2 | 3;
  class?: string;
}

const { item, priority = false, level = 3, class: className } = Astro.props as Props;

const href = item.caseStudy ? `/case-studies/${item.slug}` : item.liveUrl;
const isExternal = !item.caseStudy;
---

<li class:list={['group', className]}>
  <a
    href={href}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    target={isExternal ? '_blank' : undefined}
    class="flex flex-col gap-xs rounded-sm"
  >
    <div class="overflow-hidden rounded-sm border border-border bg-bg-subtle">
      <img
        src={item.thumbnail}
        width={item.width}
        height={item.height}
        alt={`${item.title} — ${item.tags.toLowerCase()}`}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
        sizes="(min-width: 62rem) 40vw, 92vw"
        class="work-thumb aspect-3/2 w-full object-cover"
      />
    </div>

    <div class="flex flex-wrap items-baseline justify-between gap-2xs">
      {
        level === 2 ? (
          <h2 class="text-h5 text-trim">{item.title}</h2>
        ) : (
          <h3 class="text-h5 text-trim">{item.title}</h3>
        )
      }
      <p class="text-body-sm text-text-muted">{item.tags}</p>
    </div>
  </a>
</li>
