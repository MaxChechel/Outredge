---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  body: string;
}
const { icon, title, body } = Astro.props as Props;
---

<div class="flex flex-col items-start gap-xs px-sm py-lg">
  <Icon name={icon} />
  <h3 class="text-h5 text-trim">{title}</h3>
  <p class="text-body-sm text-text-muted">{body}</p>
</div>
