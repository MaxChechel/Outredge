# Dependencies
node_modules/
.pnpm-state/
.pnpm-store/

# Local build-time tooling (fonttools, for scripts/subset-fonts.py)
.venv/

# Astro build output
dist/
.astro/
.output/

# Cloudflare / wrangler local emulator state
.wrangler/

# Environment
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json

# Webflow export: raw original video sources.
# No page references these — the site plays the smaller `_mp4.mp4` / `_webm.webm`
# transcodes alongside them. 337 MB of originals kept local, out of git history.
webflow-export/videos/*.mp4
!webflow-export/videos/*_mp4.mp4

# Clips staged locally so VIDEO_BASE is testable before the CDN pull zone exists.
# Regenerate with scripts/stage-videos.py; they are served from the CDN in prod.
public/videos/
